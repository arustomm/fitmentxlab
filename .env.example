# eBay Trading API Credentials
# Get these from https://developer.ebay.com/my/keys
EBAY_APP_ID=YourAppName-YourApp-PRD-xxxxxxxxxxxx-xxxxxxxx
EBAY_DEV_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EBAY_CERT_ID=PRD-xxxxxxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# User Auth Token — generate at developer.ebay.com > User Tokens
EBAY_USER_TOKEN=AgAAAA...your_long_token_here

# Set to "sandbox" for testing, "production" to go live
EBAY_ENVIRONMENT=sandbox

# Your PayPal email (required for Trading API listings)
EBAY_PAYPAL_EMAIL=yourpaypal@email.com
